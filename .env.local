# ─────────────────────────────────────────────────────────────────────────────
#  ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
#  Everything client-specific that is a *secret* lives here; everything that is
#  public config lives in `config/site.ts`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://rnkasjcgcsxykccrpbju.supabase.co

# Anon (publishable) key. Safe to expose to the browser — it is constrained by
# Row Level Security. Used for public reads of availability and for the
# server-side route handlers that run under RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJua2FzamNnY3N4eWtjY3JwYmp1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAzODAyNzQsImV4cCI6MjA5NTk1NjI3NH0.K9AyGadS7QMsKTNUTkovTfOk0AFNSdMh0v-Tyt-20_w

# Service-role key. SECRET — server-only, bypasses RLS. Used by the iCal import
# cron, the iCal export endpoint, and the trusted reservation-hold RPC call.
# NEVER prefix this with NEXT_PUBLIC and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJua2FzamNnY3N4eWtjY3JwYmp1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MDM4MDI3NCwiZXhwIjoyMDk1OTU2Mjc0fQ.s9UiwmxSgQTTdJNC6RSn9jWtJy95QwlS1l610Tsoy8M

# ── Resend (transactional email, free tier) ─────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_Ba648WJb_Cy89u5RbNW9Ghj7PM5rcUBLX

# Verified "from" address Resend is allowed to send as (e.g. stay@onarsyros.com).
# Must be on a domain you have verified in Resend.
RESEND_FROM_EMAIL=

# Where owner notifications are sent. Defaults to siteConfig.contact.email if
# unset, but set it explicitly for production.
OWNER_NOTIFICATION_EMAIL=

# ── Cron / admin protection ─────────────────────────────────────────────────
# Shared secret the scheduled iCal-import endpoint requires. The scheduler must
# send it as `Authorization: Bearer <CRON_SECRET>` (Vercel Cron sets this
# automatically when you configure CRON_SECRET in the project).
CRON_SECRET=

# Shared secret protecting the admin-only on-demand actions (manual sync,
# listing reservations). Sent as `Authorization: Bearer <ADMIN_TOKEN>`.
ADMIN_TOKEN=

# ── Public site URL ─────────────────────────────────────────────────────────
# Absolute base URL of the deployed site, used to build the public iCal export
# URLs the owner pastes into Booking.com / Airbnb (e.g. https://onarsyros.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
