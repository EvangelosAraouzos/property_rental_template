# ─── Keystatic storage ────────────────────────────────────────────────────────
#
# Local mode (default — no env vars needed):
#   Content is stored as git-tracked YAML files under content/.
#   Run `npm run dev` and open http://localhost:3000/keystatic.
#
# GitHub mode (set KEYSTATIC_STORAGE_KIND=github):
#   Content is committed directly to the GitHub repo via the Keystatic OAuth
#   GitHub App. Requires a Keystatic Cloud OAuth App — create one at
#   https://keystatic.cloud and follow the "GitHub App" setup guide.

# Set to "github" to switch from local → GitHub-backed CMS in production.
# KEYSTATIC_STORAGE_KIND=github

# GitHub repo where content YAML files will be stored (GitHub mode only).
# NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO_OWNER=your-org-or-username
# NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO_NAME=your-repo-name

# OAuth App slug from Keystatic Cloud (GitHub mode only).
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=your-keystatic-app-slug
